# Copier en .env puis adapter
SECRET_KEY=change-me-with-a-long-random-string
FLASK_DEBUG=1

# Notification e-mail (optionnel : laisser vide pour stocker uniquement en base)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TO=energeniecivil.sn@gmail.com

# Administration (/admin)
# Option 1 (recommandée) : créer le compte avec la commande   flask --app app create-admin
# Option 2 : renseigner ces deux lignes pour créer le premier compte au démarrage,
#            puis SUPPRIMER ADMIN_PASSWORD du fichier .env une fois connecté.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# En production (HTTPS) : cookies de session sécurisés
COOKIE_SECURE=0
